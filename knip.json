{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreFiles": ["fixtures/**/*.{js,jsx}"],
  "ignoreDependencies": ["@varlock/1password-plugin", "wrangler"],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["tests/**/*.test.ts"]
    },
    "packages/skills-autoresearch": {
      "entry": ["src/index.ts"]
    },
    "compat/flue2-role-boundary": {
      "entry": ["src/roles.ts", "tests/**/*.test.ts"]
    }
  }
}
